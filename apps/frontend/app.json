{
  "expo": {
    "name": "Vajeepurna",
    "slug": "vajeepurna",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "vchutagonnas-team",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2EDE1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vajeepurna.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F2EDE1"
      },
      "package": "com.vajeepurna.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "vajeepurna",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vajeepurna uses your photos so you can add pictures of dishes you've cooked.",
          "cameraPermission": "Vajeepurna uses your camera so you can take pictures of dishes you've cooked."
        }
      ]
    ]
  }
}
