# Copy to .env and fill in as needed — both vars have working defaults
# (see src/api.ts and src/screens/RecipeDetailScreen.tsx), so .env is only
# needed to override them for local/staging setups.

# API server. Defaults to the Metro LAN host on device, localhost otherwise.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Public web origin used to build shareable recipe links
# (https://vajeeva.app/recipe/<slug>). Defaults to https://vajeeva.app.
EXPO_PUBLIC_WEB_URL=https://vajeeva.app
